{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UC-Bench linear rank predictor",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_type", "model_version", "feature_schema_version", "genes", "coefficients", "intercept", "decision_threshold"],
  "properties": {
    "model_type": {"const": "linear_logistic_on_within_sample_gene_ranks"},
    "model_version": {"type": "string", "minLength": 1},
    "feature_schema_version": {"type": "string", "minLength": 1},
    "genes": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "coefficients": {"type": "array", "description": "One coefficient per gene, in exactly the same order as genes.", "minItems": 1, "maxItems": 50, "items": {"type": "number"}},
    "intercept": {"type": "number"},
    "decision_threshold": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
