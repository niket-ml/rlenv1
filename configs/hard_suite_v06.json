{
  "schema_version": "0.6-design-1",
  "suite_id": "uc_anti_tnf_predictor_diligence_v0_6",
  "status": "development_design_unfrozen_no_model_exposure",
  "construct": "Audit the validity of a biomedical predictor evidence chain, contain invalid claims, revise beliefs, and select the smallest decision-relevant experiment.",
  "non_constructs": [
    "de_novo_predictor_optimization",
    "paper_pipeline_reproduction",
    "obscure_biomedical_recall",
    "exact_wording_or_method_name_matching",
    "file_hunting",
    "formatting_as_scientific_difficulty"
  ],
  "scientific_score_contract": {
    "completed_artifact_quality": "Mean scientific-invariant score across artifacts that are present and parseable.",
    "artifact_coverage": "Fraction of the ten required artifacts that are present and parseable.",
    "coverage_adjusted_scientific_score": "Weighted invariant score with missing artifacts receiving zero.",
    "reliability_inclusive_score": "Zero when the final diligence action is not accepted; otherwise the coverage-adjusted scientific score.",
    "family_concentration_uses": "coverage_adjusted_scientific_score",
    "completion_reliability_reported_separately": true
  },
