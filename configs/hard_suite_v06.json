  "capabilities": [
    "data_integrity",
    "endpoint_reasoning",
    "statistical_validity",
    "leakage_prevention",
    "transportability",
    "calibration_and_decision_utility",
    "experimental_design_value_of_information",
    "belief_revision",
    "reproducibility",
    "graceful_abstention"
  ],
  "trajectory_budget": {
    "maximum_turns": 65,
    "maximum_completion_tokens_per_turn": 5000,
    "maximum_total_completion_tokens": 90000,
    "wall_clock_timeout_seconds": 4200,
    "minimum_request_interval_seconds": 3.25
  },
  "decision_contract": {
    "intended_population": "adults_with_moderate_to_severe_ulcerative_colitis_starting_first_anti_tnf",
    "target_endpoint": "week_6_clinical_response",
    "prediction_time": "baseline_pre_treatment_biopsy",
    "probability_threshold": 0.35,
    "minimum_auc": 0.7,
    "minimum_auc_ci_low": 0.58,
    "maximum_brier": 0.23,
    "minimum_net_benefit": 0.0,
    "permitted_decisions": ["advance", "conditional_advance", "pause", "stop", "insufficient_evidence"]
  },
  "resource_catalog": [
    {"resource_id": "R1", "class": "better_labels_and_metadata", "intervention": "source_record_patient_visit_reconciliation", "cost_units": 1, "description": "A curator reconciles patient, visit, biopsy, and fingerprint identities against source records."},
    {"resource_id": "R2", "class": "expert_assistance", "intervention": "blinded_ibd_endpoint_adjudication", "cost_units": 2, "description": "Two blinded IBD clinicians adjudicate the prespecified week-6 endpoint from source records."},
    {"resource_id": "R3", "class": "better_process_or_tools", "intervention": "leakage_safe_locked_pipeline_rerun", "cost_units": 1, "description": "The locked pipeline is replayed with patient-grouped splits and training-only preprocessing."},
    {"resource_id": "R4", "class": "additional_data", "intervention": "endpoint_drug_platform_matched_bridge", "cost_units": 3, "description": "An independent bridge cohort matches the intended endpoint, anti-TNF exposure, and assay platform."},
    {"resource_id": "R5", "class": "additional_data", "intervention": "larger_independent_replication", "cost_units": 3, "description": "A larger independent replication is added under the currently documented cohort contract."},
    {"resource_id": "R6", "class": "expert_assistance", "intervention": "cross_functional_expert_review_without_new_source_data", "cost_units": 1, "description": "A clinical, statistical, and platform panel reviews the existing evidence without adding records or rerunning the pipeline."}
  ],
