{
  "schema_version": "0.1",
  "task_contract": "diagnostic_decision_v0",
  "scoring_policy": {
    "version": "0.2",
    "weights": {
      "decision": 0.40,
      "diagnosis": 0.30,
      "next_action": 0.20,
      "required_evidence_recall": 0.10
    },
    "confidence": "reported_across_packets_not_scored_per_packet",
    "additional_valid_evidence_ids_are_penalized": false,
    "v0_1_action_aliases": {
      "expand_endpoint_matched_validation": "endpoint_matched_validation",
      "prospective_endpoint_matched_validation": "endpoint_matched_validation"
    },
    "wrong_decision_ceiling": 59.0
  },
  "decision_policy": {
    "advance_requires_all": {
      "auc_minimum": 0.70,
      "auc_interval_lower_strictly_above": 0.50,
      "permutation_p_maximum": 0.05,
      "evaluated_n_minimum": 100,
      "validation_usable_under_feature_contract": true,
      "no_hard_integrity_failure": true
    },
    "stop_when": "hard_integrity_failure_is_true",
    "otherwise": "insufficient_evidence"
  },
