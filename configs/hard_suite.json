{
  "schema_version": "0.2",
  "suite_id": "uc_biomarker_diligence_hard_v0",
  "status": "frozen_pre_development_model",
  "objective": "Measure composed scientific diligence, evidence diagnosis, containment, recovery design, and irreversible workflow execution; identify which resource changes the outcome.",
  "model_policy": {
    "development_models": [
      "openai/gpt-5.6-sol",
      "openai/gpt-5.4",
      "openai/gpt-5.2"
    ],
    "heldout_ceiling_probe": "openai/gpt-6-astra",
    "astra_may_not_be_used_for_task_tuning": true,
    "ranking_requires_repeated_seeds": true
  },
  "family_weights": {
    "H01_identity_metadata": 0.2,
    "H02_transfer_data": 0.2,
    "H03_process_science": 0.2,
    "H04_label_expertise": 0.2,
    "H05_evidence_sufficiency": 0.2
  },
  "acceptance_gates": {
    "frontier_mean_maximum": 85.0,
    "frontier_mean_ideal_range": [65.0, 80.0],
    "maximum_frontier_task_ceiling_rate": 0.25,
    "weakest_model_universal_failure_forbidden": true,
    "minimum_distinct_interpretable_failure_modes": 3,
    "allowed_gap_failure_domains": [
      "scientific_reasoning",
      "evidence_diagnosis",
      "recovery",
      "long_horizon_execution"
    ],
    "schema_or_json_may_not_be_primary_gap": true,
    "maximum_single_family_gap_share": 0.3,
    "infrastructure_failures": "excluded",
    "usable_unsubmitted_attempt_score": 0.0,
    "authentic_and_controlled_results_separate": true,
    "repeated_seeds_required_for_ranking": true
  },
  "local_gates": {
    "reference_minimum_score": 90.0,
    "mediocre_ranked_below_reference_every_family": true,
    "universal_advance_abstain_stop_fail": true,
    "reward_hacking_checks_pass": true,
    "answer_leakage_checks_pass": true,
    "partial_credit_graceful_degradation": true
  },
  "scoring": {
    "decision": 0.15,
    "quantitative_analysis": 0.2,
    "scientific_diagnosis": 0.2,
    "evidence_integration": 0.15,
    "recovery_design": 0.15,
    "commitment_and_reproducibility": 0.15
  },
  "intervention_catalog": {
    "additional_data": [
      "larger_validation_sample",
      "missing_subgroup_site_or_platform",
      "endpoint_matched_cohort",
      "drug_matched_cohort",
      "independent_replication"
    ],
    "better_labels_and_metadata": [
      "expert_endpoint_adjudication",
      "patient_visit_reconciliation",
      "batch_and_platform_documentation",
      "resolved_cohort_definitions"
    ],
    "expert_assistance": [
      "biostatistician",
      "transcriptomics_platform_specialist",
      "ibd_clinical_expert",
      "data_curator",
      "experimental_design_expert"
    ],
    "better_process_or_tools": [
      "leakage_safe_splitting",
      "schema_checklist_support",
      "workflow_memory",
      "commit_before_reveal_enforcement",
      "automated_integrity_and_provenance_checks"
    ],
    "model_adaptation": [
      "prompting_playbooks",
      "retrieval",
      "tool_training",
      "domain_sft",
      "rl_or_preference_optimization"
    ]
  },
  "intervention_claim_policy": {
    "tested_model_adaptations": ["prompting_playbooks"],
    "untested_model_adaptations": [
      "retrieval",
      "tool_training",
      "domain_sft",
      "rl_or_preference_optimization"
    ],
    "rule": "An intervention may be called resolving only from a predeclared paired comparison. Untested model adaptation may be proposed but never identified as necessary."
  },
  "public_decision_policy": {
    "stop_if": [
      "identity_conflict_count > 0 and identity containment is absent",
      "abs(batch_outcome_phi) >= 0.50 and a leakage-safe split has not been demonstrated"
    ],
    "advance_requires_all": [
      "identity_conflict_count == 0",
      "required_feature_retention >= 0.80",
      "abs(batch_outcome_phi) < 0.30",
      "label_disagreement_rate < 0.15",
      "matched_evidence_n >= 50",
      "matched_evidence_auc >= 0.70"
    ],
    "insufficient_evidence_otherwise": true
  },
